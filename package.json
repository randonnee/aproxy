{
  "name": "aproxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:ui": "bun run --cwd ui dev",
    "build:ui": "bun run --cwd ui build",
    "start": "bun src/index.ts",
    "go": "bun run --cwd ui build && bun src/index.ts",
    "desktop": "bun run build:ui && electrobun build && electrobun dev",
    "desktop:build": "bun run build:ui && electrobun build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  },
  "dependencies": {
    "effect": "latest",
    "electrobun": "^1.13.1"
  }
}
